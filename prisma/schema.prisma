generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  EDITOR
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  articles     Article[]
}

/// Une prestation (gardiennage, rondes, alarmes…) — entièrement éditable en back-office.
model Service {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  navLabel   String   @default("")
  tagline    String
  excerpt    String
  heroImage  String
  cardImage  String
  intro      String   @db.Text
  bodyTitle  String
  bodyHtml   String   @db.Text
  features   String[]
  formulas   Json     @default("[]")
  faqs       Json     @default("[]")
  ctaTitle   String
  ctaText    String
  metaTitle  String
  metaDesc   String
  position   Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, position])
}

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  coverImage  String
  contentHtml String    @db.Text
  tags        String[]
  readMinutes Int       @default(4)
  published   Boolean   @default(false)
  publishedAt DateTime?
  views       Int       @default(0)
  metaTitle   String?
  metaDesc    String?
  authorId    String?
  author      Admin?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

/// Une demande de devis envoyée depuis le formulaire de contact.
model Lead {
  id          String     @id @default(cuid())
  name        String
  company     String?
  email       String
  phone       String
  service     String
  city        String
  message     String?    @db.Text
  status      LeadStatus @default(NEW)
  notes       String?    @db.Text
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrer    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, createdAt])
}

/// Une vue de page, enregistrée en first-party (aucun cookie tiers).
model Pageview {
  id          String   @id @default(cuid())
  path        String
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  device      String   @default("desktop")
  country     String?
  visitorId   String
  sessionId   String
  isNew       Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([visitorId])
  @@index([utmCampaign, createdAt])
}

model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String
  alt       String   @default("")
  width     Int?
  height    Int?
  size      Int      @default(0)
  createdAt DateTime @default(now())
}

/// Réglages globaux du site (téléphone, e-mail, WhatsApp…), éditables en back-office.
model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
