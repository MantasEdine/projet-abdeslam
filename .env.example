# ------------------------------------------------------------------
# Base de données PostgreSQL (obligatoire)
# Vercel Postgres, Neon, Supabase… : copiez l'URL de connexion « pooled ».
# ------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/regiis?sslmode=require"

# ------------------------------------------------------------------
# Clé de signature des sessions d'administration (obligatoire)
# Générez-la avec :  openssl rand -base64 32
# ------------------------------------------------------------------
AUTH_SECRET="remplacez-par-32-caracteres-aleatoires-minimum"

# Adresse publique du site (pour les liens et le sitemap)
NEXT_PUBLIC_SITE_URL="https://regiis-security.com"

# ------------------------------------------------------------------
# Premier compte administrateur, créé par « npm run db:seed »
# Changez le mot de passe après la première connexion.
# ------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@regiis-security.com"
SEED_ADMIN_PASSWORD="ChangezCeMotDePasse2026!"

# ------------------------------------------------------------------
# Notification e-mail des demandes de devis (facultatif)
# Sans ces variables, les demandes restent consultables dans /admin/devis.
# Créez un compte sur resend.com et vérifiez votre domaine.
# ------------------------------------------------------------------
# RESEND_API_KEY="re_xxxxxxxxxxxx"
# LEAD_NOTIFY_TO="contact@regiis-security.com"
# LEAD_NOTIFY_FROM="Site Regiis <devis@regiis-security.com>"
